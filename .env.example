# Copy to .env and fill in OPENAI_API_KEY. Everything else has working defaults.

# --- Database ---
# SQLite file location (default: backend/data/arxiv.sqlite3).
# docker-compose overrides it with a path on a named volume.
# SQLITE_PATH=

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenAI (embeddings + answers) ---
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint. Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Changing the embedding model requires `python manage.py build_index` to re-embed the papers.
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini
RAG_TOP_K=5
# Cosine distance cut-off; papers further than this from the question are ignored.
RAG_MAX_DISTANCE=0.65

# --- arXiv ingestion ---
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# arXiv asks for at least 3 seconds between requests.
ARXIV_REQUEST_DELAY=3
ARXIV_PAGE_SIZE=100

# --- Rate limits ---
THROTTLE_ANON=300/minute
THROTTLE_ASK=20/minute
