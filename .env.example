# Copy to .env and fill in OPENAI_API_KEY. Everything else has working defaults.

# --- Database (also used by the postgres container) ---
POSTGRES_DB=arxiv
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv
# docker-compose overrides these two; they matter when running Django on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenAI (embeddings + answers) ---
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint. Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Must produce 1536-dimensional vectors (text-embedding-3-* are truncated to 1536).
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini
RAG_TOP_K=5
# Cosine distance cut-off; papers further than this from the question are ignored.
RAG_MAX_DISTANCE=0.65

# --- arXiv ingestion ---
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# arXiv asks for at least 3 seconds between requests.
ARXIV_REQUEST_DELAY=3
ARXIV_PAGE_SIZE=100

# --- Rate limits ---
THROTTLE_ANON=300/minute
THROTTLE_ASK=20/minute
